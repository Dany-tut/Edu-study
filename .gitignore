node_modules/
dist/
.vite/
.env
.env.local
.env.*.local
.DS_Store
.vercel
.env*

# editor/watcher auto-backups
*.bak
*.bak[0-9]*
*.tsx.new

# одноразовые страницы-стенды для просмотра схем/компонентов
# (_gemcheck, _figcheck, _figpreview, _all1..N) — генерируются на время
# проверки и не должны уезжать в репозиторий, тем более в public/,
# который Vercel раздаёт наружу
_*.html
public/_*.html
src/_*.tsx

# инкрементальный кэш tsc (--noEmit тоже его пишет)
tsconfig.tsbuildinfo
scripts/_*.mjs

# Кандидаты в ленту: промежуточный вывод scripts/buildFeed.mjs. Скрипт
# скачивает статьи пачкой, человек размечает нужные и переносит их в
# src/data/feed — туда и коммитятся. Держать в репозитории сырую выгрузку
# незачем: она перезаписывается на каждом прогоне и меняется вместе с лентой
# источника, то есть шумит в истории, ничего в ней не сохраняя.
scripts/feed-staging/
supabase-cli

# Кэш версии CLI: пишет сам npx supabase, в гите ему делать нечего.
supabase/.temp/

# Isolated PR29 QA builds (never served by the production build)
dist-pr29-qa/
dist-pr29-baseline/
dist-refresh409-qa/

# Архив модуля расшифровки с вложенным ffmpeg. Собирается при сборке сайта
# (prebuild → scripts/buildTranscriptionModule.mjs) и в деплое есть, а в git не
# коммитится — он большой из-за бинарника и раздувал бы репозиторий. Сам ffmpeg
# тоже не коммитим: скрипт скачивает его по закреплённому URL с проверкой sha256
# и кэширует в node_modules/.cache.
public/downloads/iskra-transcription-mac.zip
tools/local-transcription/ffmpeg
tools/local-transcription/ffmpeg.gz
tools/local-transcription/ffprobe
