# Copy to .env.local and fill in your values.

# ── Supabase (client) ─────────────────────────────────────────────────────────
# Both are PUBLIC (safe in the browser). Access is enforced by RLS policies.
# Dashboard → Settings → API.
VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Российский резерв (docs/infra/ru-proxy.md §3.3). НЕОБЯЗАТЕЛЬНО.
# Если задан — при недоступности прямого адреса Supabase из сети клиента (РФ)
# fetch и realtime автоматически уходят на этот обратный прокси. Пусто/нет —
# чистый прямой доступ, поведение не меняется. Клиент остаётся на прямом URL
# (storageKey/сессии не трогаются). Прямой адрес НЕ отключать.
# VITE_SUPABASE_PROXY_URL="https://api.iskra-study.ru"

# ── Server-only secrets (NEVER expose in client / commit) ─────────────────────
# Used only by server-side scripts / migrations, not the Vite app.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres"

# ── Legacy Express backend (unused once on Supabase) ──────────────────────────
# PORT=3001

# ── Шлюз ИИ (только локальные прогоны скриптов) ───────────────────────────────
# В браузер НЕ попадает и попасть не должен: имя без префикса VITE_ Vite в бандл
# не кладёт. Рабочие места ключа — секреты Edge Functions (Supabase) и секреты
# репозитория (GitHub Actions); здесь он нужен, только когда гоняешь
# scripts/translateFeed.mjs или buildSpnDecks.mjs руками.
# AI_BASE_URL — КОРЕНЬ шлюза без /v1/messages. LinaliAPI: https://api.linaliapi.com
# Не задан — остаётся прежний kie.ai.
# AI_API_KEY="sk-..."
# AI_BASE_URL="https://api.linaliapi.com"
