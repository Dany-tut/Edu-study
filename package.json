{
  "name": "student-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/buildLoopIcons.mjs",
    "icons:check": "node scripts/buildLoopIcons.mjs --check && node scripts/checkLoopIcons.mjs && node scripts/checkLoopIconBounds.mjs && node scripts/checkLoopFills.mjs && node scripts/checkLoopUi.mjs",
    "dev": "vite",
    "build": "node scripts/guardProductionRelease.mjs --before-build && vite build && node scripts/guardProductionRelease.mjs --after-build",
    "stamp": "node scripts/stampVersion.mjs",
    "check:gloss": "node scripts/checkGloss.mjs",
    "build:spn": "node scripts/buildSpnDecks.mjs",
    "build:gloss": "node scripts/buildGlossSeed.mjs",
    "check:questions": "node scripts/checkQuestionRu.mjs",
    "check:prose": "node scripts/checkProse.mjs",
    "check:examples": "node scripts/checkExamples.mjs",
    "build:examples": "node scripts/buildExamples.mjs",
    "check:scenes": "node scripts/checkScenes.mjs",
    "check:i18n": "node scripts/checkI18n.mjs",
    "check:cards": "node scripts/checkCardParsing.mjs",
    "preview": "vite preview",
    "build:feed": "node scripts/buildFeed.mjs",
    "check:feed": "node scripts/checkFeed.mjs",
    "adapt:feed": "node scripts/adaptFeed.mjs",
    "translate:feed": "node scripts/translateFeed.mjs",
    "check:attendance": "esbuild scripts/checkScheduleAttendance.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkScheduleAttendance.mjs --log-level=error && node node_modules/.cache/checkScheduleAttendance.mjs",
    "check:schedule": "esbuild scripts/checkScheduleState.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkScheduleState.mjs --log-level=error && node node_modules/.cache/checkScheduleState.mjs",
    "check:logic": "esbuild scripts/checkLogic.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkLogic.mjs --log-level=error && node node_modules/.cache/checkLogic.mjs",
    "check:gradebook": "esbuild scripts/checkGradebook.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkGradebook.mjs --log-level=error && node node_modules/.cache/checkGradebook.mjs",
    "check:journal-summary": "node scripts/checkJournalSummaryDb.mjs && node scripts/checkJournalSnapshotDb.mjs",
    "check:journal-loading": "esbuild scripts/checkJournalLoading.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkJournalLoading.mjs --log-level=error && node node_modules/.cache/checkJournalLoading.mjs && esbuild scripts/checkMatrixRuns.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkMatrixRuns.mjs --log-level=error && node node_modules/.cache/checkMatrixRuns.mjs && esbuild scripts/checkJournalPending.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkJournalPending.mjs --log-level=error && node node_modules/.cache/checkJournalPending.mjs",
    "check:course-journal": "esbuild scripts/checkCourseJournal.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkCourseJournal.mjs --log-level=error && node node_modules/.cache/checkCourseJournal.mjs && esbuild scripts/checkJournalRequests.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkJournalRequests.mjs --log-level=error && node node_modules/.cache/checkJournalRequests.mjs && node scripts/checkAuthDataChange.mjs",
    "stamp:seeds": "esbuild scripts/stampSeedCards.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/stampSeedCards.mjs --log-level=error && node node_modules/.cache/stampSeedCards.mjs",
    "check:lesson": "esbuild scripts/checkLesson.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkLesson.mjs --log-level=error && node node_modules/.cache/checkLesson.mjs",
    "check:choicepos": "esbuild scripts/checkChoicePos.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkChoicePos.mjs --log-level=error --define:import.meta.env='{\"VITE_SUPABASE_URL\":\"http://stub.local\",\"VITE_SUPABASE_PUBLISHABLE_KEY\":\"stub\"}' && node node_modules/.cache/checkChoicePos.mjs",
    "check:light": "esbuild scripts/checkLightData.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkLightData.mjs --log-level=error && node node_modules/.cache/checkLightData.mjs",
    "check:exams": "node scripts/checkExamClaims.mjs",
    "check:teacher-view": "node scripts/checkTeacherView.mjs && node scripts/checkTeacherToday.mjs && esbuild scripts/checkWorkspaceRoute.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkWorkspaceRoute.mjs --log-level=error && node node_modules/.cache/checkWorkspaceRoute.mjs",
    "check:homework-results": "esbuild scripts/checkHomeworkResults.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkHomeworkResults.mjs --log-level=error && node node_modules/.cache/checkHomeworkResults.mjs",
    "check:course-track": "node scripts/checkCourseTrack.mjs",
    "build:diag-defaults": "esbuild scripts/buildDiagDefaults.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/buildDiagDefaults.mjs --log-level=error && node node_modules/.cache/buildDiagDefaults.mjs",
    "check:homework-attempts": "node scripts/checkHomeworkAttempts.mjs",
    "check:lesson-participation": "node scripts/checkLessonParticipation.mjs",
    "check:course-access": "esbuild scripts/checkCourseAccess.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkCourseAccess.mjs --log-level=error && node node_modules/.cache/checkCourseAccess.mjs && node scripts/checkCourseAccessDb.mjs",
    "release:check": "npm run check:ui && node scripts/guardProductionRelease.mjs --check",
    "check:release": "node scripts/checkReleasePolicy.mjs",
    "check:feed-release": "node scripts/checkFeedRelease.mjs",
    "check:diary-views": "node scripts/checkStudentDiaryViews.mjs",
    "check:student-journal": "node scripts/checkStudentWorkJournal.mjs",
    "check:drive-video": "deno test --no-lock --node-modules-dir=auto --allow-env supabase/functions/_shared/driveVideo_test.ts supabase/functions/drive-video/index_test.ts",
    "check:video-access": "node scripts/checkHomeworkVideoAccess.mjs",
    "check:student-home": "node scripts/checkStudentHomeWork.mjs",
    "check:ui": "node scripts/checkUiRules.mjs && node scripts/checkWidgetSizing.mjs && npm run icons:check",
    "check:text-fades": "node scripts/checkTextFades.mjs && node scripts/checkTextFadeVisibility.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.108.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.15",
    "posthog-js": "^1.386.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.185.1",
    "vite": "^5.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.6",
    "@types/three": "^0.185.4",
    "typescript": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  }
}
