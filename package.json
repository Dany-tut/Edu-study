{
  "name": "student-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "stamp": "node scripts/stampVersion.mjs",
    "check:gloss": "node scripts/checkGloss.mjs",
    "build:spn": "node scripts/buildSpnDecks.mjs",
    "build:gloss": "node scripts/buildGlossSeed.mjs",
    "check:questions": "node scripts/checkQuestionRu.mjs",
    "check:prose": "node scripts/checkProse.mjs",
    "check:examples": "node scripts/checkExamples.mjs",
    "build:examples": "node scripts/buildExamples.mjs",
    "check:scenes": "node scripts/checkScenes.mjs",
    "check:i18n": "node scripts/checkI18n.mjs",
    "preview": "vite preview",
    "build:feed": "node scripts/buildFeed.mjs",
    "check:feed": "node scripts/checkFeed.mjs",
    "adapt:feed": "node scripts/adaptFeed.mjs",
    "translate:feed": "node scripts/translateFeed.mjs",
    "check:logic": "esbuild scripts/checkLogic.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkLogic.mjs --log-level=error && node node_modules/.cache/checkLogic.mjs",
    "stamp:seeds": "esbuild scripts/stampSeedCards.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/stampSeedCards.mjs --log-level=error && node node_modules/.cache/stampSeedCards.mjs",
    "check:lesson": "esbuild scripts/checkLesson.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkLesson.mjs --log-level=error && node node_modules/.cache/checkLesson.mjs",
    "check:choicepos": "esbuild scripts/checkChoicePos.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkChoicePos.mjs --log-level=error --define:import.meta.env='{\"VITE_SUPABASE_URL\":\"http://stub.local\",\"VITE_SUPABASE_PUBLISHABLE_KEY\":\"stub\"}' && node node_modules/.cache/checkChoicePos.mjs",
    "check:light": "esbuild scripts/checkLightData.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/checkLightData.mjs --log-level=error && node node_modules/.cache/checkLightData.mjs",
    "check:exams": "node scripts/checkExamClaims.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.108.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.15",
    "posthog-js": "^1.386.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.185.1",
    "vite": "^5.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.6",
    "@types/three": "^0.185.4",
    "typescript": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  }
}
