generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  avatarUrl String?
  createdAt DateTime @default(now())

  stats            StudentStats?
  homeworkAttempts HomeworkAttempt[]
  lessonProgress   LessonProgress[]
}

model StudentStats {
  id             String  @id @default(cuid())
  studentId      String  @unique
  performance    Int     @default(0)
  completedTasks Int     @default(0)
  totalTasks     Int     @default(0)
  avgScore       Int     @default(0)
  streak         Int     @default(0)
  totalPoints    Int     @default(0)
  student        Student @relation(fields: [studentId], references: [id])
}

model Subject {
  id      String   @id  // 'chemistry', 'math', 'biology', 'physics', 'russian'
  name    String
  emoji   String?
  modules Module[]
}

model Module {
  id        String  @id @default(cuid())
  subjectId String
  label     String
  order     Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  lessons   Lesson[]
}

model Lesson {
  id          String   @id  // e.g. 'c1-1'
  moduleId    String
  title       String
  number      Int
  shape       String   @default("circle")  // 'circle', 'square', 'diamond'
  youtubeUrl  String?
  description String?
  materials   Json?    // array of { type, title, url }
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  module      Module   @relation(fields: [moduleId], references: [id])

  homeworkQuestions HomeworkQuestion[]
  studentProgress   LessonProgress[]
  scheduleItems     ScheduleItem[]
  homeworkAttempts  HomeworkAttempt[]
}

model ScheduleItem {
  id        String @id @default(cuid())
  lessonId  String
  dayOffset Int    // relative day offset used in the carousel (-7..+7)
  time      String // "11:00"
  subject   String // display name, e.g. "Химия"
  passed    Boolean @default(false)
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
}

model HomeworkQuestion {
  id           String   @id @default(cuid())
  lessonId     String
  question     String
  options      Json     // string[]
  correctIndex Int
  order        Int      @default(0)
  lesson       Lesson   @relation(fields: [lessonId], references: [id])
}

model HomeworkAttempt {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  answers     Json     // number[] — selected option per question
  score       Int
  total       Int
  submittedAt DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
}

model LessonProgress {
  id        String    @id @default(cuid())
  studentId String
  lessonId  String
  status    String    // 'completed', 'submitted', 'current', 'returned', 'locked', 'unviewed'
  points    Int?
  comment   String?
  updatedAt DateTime  @updatedAt
  student   Student   @relation(fields: [studentId], references: [id])
  lesson    Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
}
